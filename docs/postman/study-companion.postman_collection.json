{
  "info": {
    "name": "Study Companion API (live endpoints)",
    "description": "Live endpoints as of Module 9. Import into Postman, run the dev server (npm run dev), then run requests top to bottom. Upload requests use Body → binary: pick a file in Postman. Contract: docs/API_SPEC.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "learnerId",
      "value": "demo-learner"
    },
    {
      "key": "sourceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().ok).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Health + Gemini (no tokens)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health?gemini=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ],
              "query": [
                {
                  "key": "gemini",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('all models reachable', () => { const g = pm.response.json().gemini; pm.expect(Object.values(g).every(m => m.ok)).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Learners",
      "item": [
        {
          "name": "List learners",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/learners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "learners"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create learner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Asha\" }"
            },
            "url": {
              "raw": "{{baseUrl}}/api/learners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "learners"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, has id', () => { pm.response.to.have.status(200); pm.collectionVariables.set('learnerId', pm.response.json().id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create learner: invalid (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"   \" }"
            },
            "url": {
              "raw": "{{baseUrl}}/api/learners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "learners"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 bad_request', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error.code).to.eql('bad_request'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sources",
      "item": [
        {
          "name": "Upload source (Body → binary: pick a .pdf/.pptx/.mp4; set ?filename)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sources?filename=chapter.pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sources"
              ],
              "query": [
                {
                  "key": "filename",
                  "value": "chapter.pdf",
                  "description": "Must end in .pdf, .pptx or .mp4 and match the file's content"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 PENDING', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('PENDING'); pm.collectionVariables.set('sourceId', pm.response.json().id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ingest source (spends Gemini quota; cached re-runs are free)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/sources/{{sourceId}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sources",
                "{{sourceId}}",
                "ingest"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 PROCESSING (poll List sources)\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql(\"PROCESSING\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List sources",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sources"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get file (full)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/files/{{sourceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{sourceId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with Accept-Ranges', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Accept-Ranges')).to.eql('bytes'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get file (Range: first 100 bytes → 206)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Range",
                "value": "bytes=0-99"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{sourceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{sourceId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('206 partial', () => { pm.response.to.have.status(206); pm.expect(pm.response.headers.get('Content-Range')).to.match(/^bytes 0-99\\//); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete source",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/sources/{{sourceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sources",
                "{{sourceId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with id', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('sourceId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete source again (expect 404)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/sources/{{sourceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sources",
                "{{sourceId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 not_found', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error.code).to.eql('not_found'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Search the knowledge base",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"What happens to a process when it waits for I/O?\",\"k\":6}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "search"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 with citations\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().results.length).to.be.above(0); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Course build",
      "item": [
        {
          "name": "Build course (1 Gemini request + topic embeddings; rebuild of unchanged material is free)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/build",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "build"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with topics', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().topics.length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List topics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/topics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, array in seq order', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List topics of another course",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/topics?courseId=pptx-vm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics"
              ],
              "query": [
                {
                  "key": "courseId",
                  "value": "pptx-vm"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Build: invalid body (expect 400)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/build",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "build"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"force\": \"yes\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 bad_request', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error.code).to.eql('bad_request'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
